# Workshop Engine — zkopíruj do .env.local (nikdy necommituj)

# Interní cockpit /workshop/engine (HTTP Basic)
ENGINE_USER=engine
ENGINE_PASSWORD=zmen-me

# Neon Postgres (povinné v produkci na Vercel)
# Vercel + Neon Storage často vyplní POSTGRES_URL místo DATABASE_URL — Engine bere obě.
DATABASE_URL=
# POSTGRES_URL=

# Stripe webhook (Source of truth pro nákupy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Facebook Marketing API (volitelné v MVP — cockpit ukáže placeholder)
FB_ACCESS_TOKEN=
FB_AD_ACCOUNT_ID=

# Clarity Data Export API (volitelné, později)
CLARITY_API_TOKEN=

# Veřejné (už používané landingem)
NEXT_PUBLIC_SITE_URL=https://poznej.coachville.eu/workshop
NEXT_PUBLIC_CONTACT_EMAIL=ales@coachville.eu
